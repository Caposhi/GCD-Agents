# GCD-SOCIAL — safe local template. Copy to .env; never commit real values.

# Runtime/state
NODE_ENV=development
PORT=3000
# Restrict the local API listener. Render leaves this unset so the service uses
# its platform-required wildcard interface.
API_BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://gcd_social_local:gcd_social_local@localhost:5432/gcd_social_local
# Content Studio only (docs/CONTENT_STUDIO_DESIGN.md §3.2, §3.7): the Studio's own
# PostgreSQL database, which must be named gcd_studio. Read only by Studio processes
# (`npm run studio:migrate`), never by a live service. The Studio runner refuses to
# run while DATABASE_URL is present in its environment, so a Studio shell sets this
# variable and unsets DATABASE_URL; a live process never carries this one.
STUDIO_DATABASE_URL=postgresql://gcd_studio_local:gcd_studio_local@localhost:5432/gcd_studio
# Content Studio worker only (`npm run start:studio-worker`; design §6.2): its own
# deployment-time spend ceilings in USD, the owner's chosen values (design §11.1a).
# Missing or unreadable counts as zero, which refuses every paid request. The worker
# refuses to start beside DATABASE_URL, any live credential and, until S6b (the
# live-runner enablement; owner decision of 2026-10-05), ANTHROPIC_API_KEY — so a
# Studio shell does not source this file whole.
STUDIO_MAX_DAILY_USD=75
STUDIO_MAX_MONTHLY_USD=300
# Content Studio web only (`npm run start:studio-web`; design §3.2, §7). It refuses to
# start beside DATABASE_URL, any live credential or ANTHROPIC_API_KEY (always, in every
# phase), so a Studio shell does not source this file whole. It reads PORT above, and
# STUDIO_DATABASE_URL. STUDIO_PUBLIC_ORIGIN is the Studio's exact https origin, with no
# path or trailing slash: the OAuth redirect URI (<origin>/auth/callback) and the CSRF
# Origin check derive from it, never from the Host header. Its real value is TO VERIFY
# once Render assigns it (S8, owner action O3); this placeholder is not a real host.
STUDIO_PUBLIC_ORIGIN=https://studio.example.invalid
# The only accepted Google Workspace domain; the web refuses any other value.
STUDIO_ALLOWED_HD=germancardepot.com
# The Studio's own Google OAuth client (owner action O1), NOT the live GBP client's
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET. Set only in the Render dashboard; never commit.
STUDIO_GOOGLE_CLIENT_ID=
STUDIO_GOOGLE_CLIENT_SECRET=
# Read only while no owner exists: the Workspace user account whose first verified
# sign-in becomes the owner (design §7.2). Ignored once an owner exists; unset refuses
# the bootstrap. Set only in the Render dashboard; never commit an address.
STUDIO_BOOTSTRAP_OWNER_EMAIL=
# Local API origin. Production approval delivery requires a public root HTTPS
# origin; generated-media hosting requires a root HTTPS origin in every mode.
# Neither accepts credentials, a path, query, or fragment.
PUBLIC_BASE_URL=http://localhost:3000

# Model/image providers — blank disables credential-bound calls
ANTHROPIC_API_KEY=
IMAGEGEN_API_KEY=

# Dormant manager-turn harness only; production worker uses deterministic orchestration
MANAGER_MODEL=claude-opus-5

# Meta publishing — these non-secret IDs/host/version become part of the exact
# approval-bound publication target; runtime values must still match at publish.
# Use dedicated test assets locally. The worker's IG refresh
# loop runs only when instagram is active; approved work retrieves its live token
# only when the exact approved payload array contains Instagram.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.instagram.com
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
GRAPH_VERSION=v25.0

# Google Business Profile. Account/location plus the fixed API host/version are
# approval-bound. OAuth refresh is attempted after approval only when the exact
# approved payload array contains GBP.
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Human approval — Slack is the only notification channel. The worker approval
# flow requires an HTTPS hooks.slack.com/services webhook in every environment;
# leave this blank only when no worker/approval-delivery path will run. Failed or
# uncertain delivery must end in confirmed revocation or a surfaced composite error.
# Decision links and publication authorization expire after 24 hours by default.
# Approval GET/decision share an in-process 300/minute direct-socket bucket plus
# a 30/minute direct-socket+approval-UUID bucket; only UUID-shaped IDs route.
APPROVAL_CHANNEL_WEBHOOK=

# Transitional shared secret for /triggers, /diag/*, and /console/*. Protected
# routes fail closed when blank. Send in Authorization: Bearer or
# x-console-token; query-string credentials are not accepted.
CONSOLE_TOKEN=local-development-console-token

# Safety/configuration. Every autonomy value still requires durable exact-payload
# approval immediately before every provider HTTP attempt, including reads and retries;
# A remains the operating mode.
AUTONOMY_PHASE=A
ACTIVE_PLATFORMS=instagram,facebook

# Dormant manager-turn context settings
COMPACT_CONTEXT_THRESHOLD=160000
COMPACT_CONTEXT_INTERVAL=60000
SESSION_START_MAX_CHARS=20000
